<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="defs_net" name="Networking">
  <decision id="dec_net" name="Network Lookup">
    <variable name="network" typeRef="string"/>
    <decisionTable id="dt_net" hitPolicy="UNIQUE">
      <input id="in_bu" label="Business Unit">
        <inputExpression typeRef="string"><text>business_unit</text></inputExpression>
      </input>
      <input id="in_env" label="Environment">
        <inputExpression typeRef="string"><text>environment</text></inputExpression>
      </input>
      <output id="out_subnet" name="subnet_id" typeRef="string"/>
      <rule id="r1">
        <inputEntry><text>"payments"</text></inputEntry>
        <inputEntry><text>"prod"</text></inputEntry>
        <outputEntry><text>"subnet-aaa"</text></outputEntry>
      </rule>
      <rule id="r2">
        <inputEntry><text>"payments"</text></inputEntry>
        <inputEntry><text>"dev"</text></inputEntry>
        <outputEntry><text>"subnet-bbb"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
